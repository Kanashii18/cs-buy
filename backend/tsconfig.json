{
     "compilerOptions": {
          "target": "esnext",
          "module": "NodeNext",
          "moduleResolution": "NodeNext",
          "sourceMap": false,
          "outDir": "./dir",
          "rootDir": "./api",
          "forceConsistentCasingInFileNames": true,
          "resolveJsonModule": true,
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true,
          "noEmit": true,
          "allowImportingTsExtensions": true
     },
     "include": ["./api/**/*.ts"],
     "exclude": ["node_modules"]
}